{
  "manifest_version": 3,
  "name": "Piazza",
  "version": "1.5.0",
  "description": "Raccoglie post e commenti dalla pagina Facebook o Instagram che stai guardando, li archivia in locale e ne dà una lettura aggregata.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Piazza — raccogli questa pagina",
    "default_icon": {
      "16": "icona-16.png",
      "32": "icona-32.png",
      "48": "icona-48.png",
      "128": "icona.png"
    }
  },
  "icons": {
    "16": "icona-16.png",
    "32": "icona-32.png",
    "48": "icona-48.png",
    "128": "icona.png"
  },
  "background": {
    "service_worker": "sfondo.js",
    "type": "module"
  },
  "options_page": "archivio.html"
}
